# Copia este archivo como .env. Nunca subas .env al repositorio.
ENVIRONMENT=development
# Solo se usa al ejecutar `python scripts/provision_database.py`.
POSTGRES_ADMIN_DSN=postgresql://postgres:CONTRASENA_ADMIN@localhost:5432/postgres
APP_DATABASE_NAME=db_health_monitor
APP_DATABASE_USER=db_health_app
APP_DATABASE_PASSWORD=usar-una-contrasena-larga-y-unica
# La API y Alembic usan esta cuenta, nunca la administradora.
DATABASE_URL=postgresql+psycopg://db_health_app:CONTRASENA_APP@localhost:5432/db_health_monitor
JWT_SECRET_KEY=reemplazar-por-un-secreto-largo-y-aleatorio
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=reemplazar-por-clave-fernet
LOG_LEVEL=INFO
# Lista JSON de orígenes permitidos para el frontend. No uses "*" con credenciales.
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
MONITORING_WORKER_POLL_SECONDS=5
MONITORING_LEASE_SECONDS=90
MONITORING_WORKER_BATCH_SIZE=25
