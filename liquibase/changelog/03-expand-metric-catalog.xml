    <changeSet id="03-expand-metric-catalog-batch1" author="group-3">
        <comment>Ampliación del catálogo con métricas operativas y de caché (Fase 1)</comment>
        
        <!-- MongoDB Batch 1 -->
        <insert tableName="metric_definitions">
            <column name="id" value="00000000-0000-0000-0000-000000000105"/>
            <column name="engine_id" value="mongodb"/>
            <column name="code" value="connections_usage_percent"/>
            <column name="display_name" value="Uso de conexiones"/>
            <column name="unit" value="percent"/>
            <column name="alert_direction" value="above"/>
            <column name="description" value="Porcentaje de conexiones actuales sobre la capacidad reportada."/>
            <column name="is_enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="metric_definitions">
            <column name="id" value="00000000-0000-0000-0000-000000000106"/>
            <column name="engine_id" value="mongodb"/>
            <column name="code" value="uptime_seconds"/>
            <column name="display_name" value="Tiempo activo"/>
            <column name="unit" value="seconds"/>
            <column name="alert_direction" value="below"/>
            <column name="description" value="Segundos transcurridos desde el último inicio de MongoDB."/>
            <column name="is_enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="metric_definitions">
            <column name="id" value="00000000-0000-0000-0000-000000000107"/>
            <column name="engine_id" value="mongodb"/>
            <column name="code" value="network_bytes_in"/>
