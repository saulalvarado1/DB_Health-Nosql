            <column name="description" value="Bytes recibidos acumulados desde el inicio de MongoDB."/>
            <column name="is_enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="metric_definitions">
            <column name="id" value="00000000-0000-0000-0000-000000000108"/>
            <column name="engine_id" value="mongodb"/>
            <column name="code" value="network_bytes_out"/>
            <column name="display_name" value="Red enviada"/>
            <column name="unit" value="bytes"/>
            <column name="alert_direction" value="above"/>
            <column name="description" value="Bytes enviados acumulados desde el inicio de MongoDB."/>
            <column name="is_enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="metric_definitions">
            <column name="id" value="00000000-0000-0000-0000-000000000109"/>
            <column name="engine_id" value="mongodb"/>
            <column name="code" value="wiredtiger_cache_usage_percent"/>
            <column name="display_name" value="Uso de caché WiredTiger"/>
            <column name="unit" value="percent"/>
            <column name="alert_direction" value="above"/>
            <column name="description" value="Porcentaje de la caché WiredTiger que está en uso."/>
            <column name="is_enabled" valueBoolean="true"/>
        </insert>

        <!-- Redis Batch 1 -->
        <insert tableName="metric_definitions">
            <column name="id" value="00000000-0000-0000-0000-000000000207"/>
            <column name="engine_id" value="redis"/>
            <column name="code" value="blocked_clients"/>
            <column name="display_name" value="Clientes bloqueados"/>
            <column name="unit" value="clients"/>
            <column name="alert_direction" value="above"/>
            <column name="description" value="Clientes esperando una operación bloqueante en Redis."/>
            <column name="is_enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="metric_definitions">
            <column name="id" value="00000000-0000-0000-0000-000000000208"/>
            <column name="engine_id" value="redis"/>
            <column name="code" value="evicted_keys"/>
            <column name="display_name" value="Claves expulsadas"/>
            <column name="unit" value="keys"/>
            <column name="alert_direction" value="above"/>
            <column name="description" value="Claves expulsadas acumuladas por el límite de memoria de Redis."/>
            <column name="is_enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="metric_definitions">
            <column name="id" value="00000000-0000-0000-0000-000000000209"/>
            <column name="engine_id" value="redis"/>
            <column name="code" value="keyspace_hit_rate_percent"/>
            <column name="display_name" value="Aciertos de caché"/>
            <column name="unit" value="percent"/>
            <column name="alert_direction" value="below"/>
            <column name="description" value="Porcentaje de búsquedas de claves que Redis resolvió con éxito."/>
            <column name="is_enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="metric_definitions">
            <column name="id" value="00000000-0000-0000-0000-000000000210"/>
            <column name="engine_id" value="redis"/>
            <column name="code" value="memory_fragmentation_ratio"/>
            <column name="display_name" value="Fragmentación de memoria"/>
            <column name="unit" value="ratio"/>
            <column name="alert_direction" value="above"/>
            <column name="description" value="Relación entre memoria residente y memoria asignada por Redis."/>
            <column name="is_enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="metric_definitions">
            <column name="id" value="00000000-0000-0000-0000-000000000211"/>
            <column name="engine_id" value="redis"/>
            <column name="code" value="uptime_seconds"/>
            <column name="display_name" value="Tiempo activo"/>
            <column name="unit" value="seconds"/>
            <column name="alert_direction" value="below"/>
            <column name="description" value="Segundos transcurridos desde el último inicio de Redis."/>
            <column name="is_enabled" valueBoolean="true"/>
        </insert>

        <rollback>
            <delete tableName="metric_definitions">
                <where>code IN ('connections_usage_percent', 'uptime_seconds', 'network_bytes_in', 'network_bytes_out', 'wiredtiger_cache_usage_percent', 'blocked_clients', 'evicted_keys', 'keyspace_hit_rate_percent', 'memory_fragmentation_ratio')</where>
            </delete>
        </rollback>
    </changeSet>

