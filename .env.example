# Configuración de Producción para DB Health Monitor
COMPOSE_PROJECT_NAME=db-health-monitor
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=80

# Base de datos interna de la plataforma (PostgreSQL)
POSTGRES_DB=db_health_monitor
POSTGRES_USER=db_health_app
POSTGRES_PASSWORD=supersecure_db_password_2026!
DATABASE_URL=postgresql+psycopg://db_health_app:supersecure_db_password_2026!@postgres:5432/db_health_monitor

# Secretos y llaves criptográficas
JWT_SECRET_KEY=vps-jwt-secret-dbhealth-2026-ultra-secure
CREDENTIALS_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Autenticación con Google (OAuth 2.0 Web Client)
GOOGLE_CLIENT_ID=892218304693-b4tb324t5loagu8vctiee2j1qs64itu6.apps.googleusercontent.com

# Niveles de registro y tiempos de monitoreo
LOG_LEVEL=INFO
MONITORING_WORKER_POLL_SECONDS=5
MONITORING_LEASE_SECONDS=90
MONITORING_WORKER_BATCH_SIZE=25
